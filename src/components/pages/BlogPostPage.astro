---
// Shared blog post body. Each locale route (pages/blog/[slug].astro,
// pages/es/blog/[slug].astro) exports `getStaticPaths` via makeBlogPaths()
// and forwards the resolved post here.
import Layout from "../../layouts/Layout.astro";
import Footer from "../Footer.astro";
import BlogPost from "../BlogPost.astro";
import type { BlogEntry } from "../../lib/blog";

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const canonical = post.data.lang === "es" ? post.data.canonical : undefined;
---

<Layout title={`${post.data.title} | LADETEC`} canonical={canonical}>
  <BlogPost post={post} />
  <Footer />
</Layout>
