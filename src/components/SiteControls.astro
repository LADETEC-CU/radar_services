---
// Site-wide fixed control bar (nav menu + theme toggle + language switch),
// extracted from Hero so blog/post routes get the same chrome. Rendered once
// per page from Layout.astro. Nav anchors are prefixed with the locale home
// URL so they work from any route; on the home page they resolve to same-page
// jumps ("/#hardware"), elsewhere they navigate home first.
// Styles: src/styles/site-controls.css · runtime logic: src/scripts/site-controls.ts
import "../styles/site-controls.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveLang, useTranslations, otherLang, getRouteFromPathname } from "../i18n/utils";
import { localeCode } from "../i18n/ui";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const target = otherLang(lang);
const route = getRouteFromPathname(Astro.url.pathname, lang);
const switchHref = getRelativeLocaleUrl(target, route);
const homeHref = getRelativeLocaleUrl(lang, "");
const blogHref = getRelativeLocaleUrl(lang, "blog");
const onBlog = route === "blog" || route.startsWith("blog/");
// Home renders the split hero (copy | map): center the capsule over the map
// column. Any other route has no map, so it centers on the viewport.
const onHome = route === "";
---

<div class:list={["rh-controls", { "rh-controls--map": onHome }]}>
  <div class="rh-menu" id="hero-menu">
    <button
      id="hero-menu-toggle"
      class="rh-menu-toggle"
      aria-label={t("nav.menuLabel")}
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="hero-menu-panel"
    >
      <span class="material-symbols-outlined menu-icon-open">menu</span>
      <span class="material-symbols-outlined menu-icon-close">close</span>
    </button>
    <nav id="hero-menu-panel" class="rh-menu-panel">
      <a href={`${homeHref}#hero`}>{t("nav.home")}</a>
      <a href={`${homeHref}#hardware`}>{t("nav.hardware")}</a>
      <a href={`${homeHref}#software`}>{t("nav.software")}</a>
      <a href={`${homeHref}#rd`}>{t("nav.rd")}</a>
      <a href={`${homeHref}#contact`}>{t("nav.contact")}</a>
      <a href={blogHref} class:list={[{ "is-active": onBlog }]}>{t("nav.blog")}</a>
    </nav>
  </div>

  <span class="rh-controls__sep" aria-hidden="true"></span>

  <button id="hero-theme-toggle" class="js-theme-toggle rh-theme-toggle" aria-label="Toggle Theme">
    <span class="material-symbols-outlined theme-icon-moon">dark_mode</span>
    <span class="material-symbols-outlined theme-icon-sun">light_mode</span>
  </button>

  <a
    id="lang-toggle"
    class="rh-lang"
    href={switchHref}
    hreflang={target}
    aria-label={t("nav.switchLabel")}
  >
    {localeCode[target]}
  </a>
</div>

<script>
  import "../scripts/site-controls";
</script>
