---
// Floating capsule navbar: nav menu + theme toggle + language switch.
// Rendered site-wide in Layout.astro.
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveLang, useTranslations, otherLang, getRouteFromPathname } from "../i18n/utils";
import "../styles/site-controls.css";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const target = otherLang(lang);
const route = getRouteFromPathname(Astro.url.pathname, lang);
const isBlogPost = route.startsWith("blog/") && route !== "blog";
const switchHref = isBlogPost
  ? getRelativeLocaleUrl(target, "blog")
  : getRelativeLocaleUrl(target, route);
const homeHref = getRelativeLocaleUrl(lang, "");
const blogHref = getRelativeLocaleUrl(lang, "blog");
const onBlog = route === "blog" || route.startsWith("blog/");
---

<header id="site-controls" class="lh-bar fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <div class="lh-pill flex items-center gap-2 rounded-full px-4 py-2 shadow-2xl backdrop-blur-md">
    <!-- Navigation Menu (Dropdown / Link Row) -->
    <nav class="relative flex items-center">
      <button
        type="button"
        id="lh-menu-toggle"
        class="lh-menu-btn flex items-center gap-2 rounded-full px-3 py-1.5 font-technical-label text-technical-label tracking-widest uppercase transition-colors"
        aria-expanded="false"
        aria-controls="lh-nav-links"
        aria-label={t("nav.menuLabel")}
      >
        <span class="material-symbols-outlined text-base">menu</span>
        <span>{t("nav.home")}</span>
      </button>

      <div
        id="lh-nav-links"
        class="lh-nav-dropdown absolute top-full left-0 mt-2 hidden min-w-[200px] flex-col rounded-lg p-2 shadow-xl"
      >
        <a href={homeHref} class="lh-nav-link rounded-md px-3 py-2 text-sm transition-colors">
          {t("nav.home")}
        </a>
        {
          !onBlog && (
            <>
              <a
                href="#hardware"
                class="lh-nav-link rounded-md px-3 py-2 text-sm transition-colors"
              >
                {t("nav.hardware")}
              </a>
              <a
                href="#software"
                class="lh-nav-link rounded-md px-3 py-2 text-sm transition-colors"
              >
                {t("nav.software")}
              </a>
              <a href="#rd" class="lh-nav-link rounded-md px-3 py-2 text-sm transition-colors">
                {t("nav.rd")}
              </a>
              <a href="#contact" class="lh-nav-link rounded-md px-3 py-2 text-sm transition-colors">
                {t("nav.contact")}
              </a>
            </>
          )
        }
        <a href={blogHref} class="lh-nav-link rounded-md px-3 py-2 text-sm transition-colors">
          {t("nav.blog")}
        </a>
      </div>
    </nav>

    <div class="h-4 w-px bg-outline-variant/40"></div>

    <!-- Theme Toggler Button -->
    <button
      type="button"
      class="js-theme-toggle lh-icon-btn flex h-8 w-8 items-center justify-center rounded-full transition-colors"
      aria-label="Toggle theme"
    >
      <span class="material-symbols-outlined text-base dark:hidden">light_mode</span>
      <span class="material-symbols-outlined hidden text-base dark:inline">dark_mode</span>
    </button>

    <!-- Language Switcher Link -->
    <a
      href={switchHref}
      class="lh-icon-btn flex h-8 w-8 items-center justify-center rounded-full font-technical-label text-xs font-bold uppercase transition-colors"
      aria-label={t("nav.switchLabel")}
    >
      {target}
    </a>
  </div>
</header>

<script src="../scripts/site-controls.ts"></script>
