---
// Site-wide fixed control bar (nav menu + theme toggle + language switch),
// extracted from Hero so blog/post routes get the same chrome. Rendered once
// per page from Layout.astro. Nav anchors are prefixed with the locale home
// URL so they work from any route; on the home page they resolve to same-page
// jumps ("/#hardware"), elsewhere they navigate home first.
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveLang, useTranslations, otherLang, getRouteFromPathname } from "../i18n/utils";
import { localeCode } from "../i18n/ui";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const target = otherLang(lang);
const route = getRouteFromPathname(Astro.url.pathname, lang);
const switchHref = getRelativeLocaleUrl(target, route);
const homeHref = getRelativeLocaleUrl(lang, "");
const blogHref = getRelativeLocaleUrl(lang, "blog");
const onBlog = route === "blog" || route.startsWith("blog/");
---

<div class="rh-controls">
  <div class="rh-menu" id="hero-menu">
    <button
      id="hero-menu-toggle"
      class="rh-menu-toggle"
      aria-label={t("nav.menuLabel")}
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="hero-menu-panel"
    >
      <span class="material-symbols-outlined menu-icon-open">menu</span>
      <span class="material-symbols-outlined menu-icon-close">close</span>
    </button>
    <nav id="hero-menu-panel" class="rh-menu-panel">
      <a href={`${homeHref}#hero`}>{t("nav.home")}</a>
      <a href={`${homeHref}#hardware`}>{t("nav.hardware")}</a>
      <a href={`${homeHref}#software`}>{t("nav.software")}</a>
      <a href={`${homeHref}#rd`}>{t("nav.rd")}</a>
      <a href={`${homeHref}#contact`}>{t("nav.contact")}</a>
      <a href={blogHref} class:list={[{ "is-active": onBlog }]}>{t("nav.blog")}</a>
    </nav>
  </div>

  <button id="hero-theme-toggle" class="js-theme-toggle rh-theme-toggle" aria-label="Toggle Theme">
    <span class="material-symbols-outlined theme-icon-moon">dark_mode</span>
    <span class="material-symbols-outlined theme-icon-sun">light_mode</span>
  </button>

  <a
    id="lang-toggle"
    class="rh-lang"
    href={switchHref}
    hreflang={target}
    aria-label={t("nav.switchLabel")}
  >
    {localeCode[target]}
  </a>
</div>

<style is:global>
  /* Controls (menu + theme toggle + language switch). Fixed to the viewport
     so they stay visible and usable the whole page down — this is the site's
     only nav, on every route. */
  /* Also the positioned ancestor for .rh-menu-panel — the dropdown right-aligns
     to this group's own right edge, stable regardless of where the menu button
     falls in flex order (it moves via `order` on mobile). */
  .rh-controls {
    /* Own copy of the hero palette vars — this bar renders outside
       .radar-hero (where they were originally defined). Dark defaults;
       light overrides below. */
    --lh-line: #1d2b32;
    --lh-text: #ebf1f3;
    --lh-teal: #2fe6c3;
    --lh-teal-dim: rgba(47, 230, 195, 0.14);

    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 1001;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.25s ease;
    /* Menu/theme/lang have transparent backgrounds on desktop, so whatever
       scrolls underneath can match their text color — a soft drop shadow
       keeps icons/labels legible against any page background. */
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.55));
  }
  html:not(.dark) .rh-controls {
    --lh-line: #d8dee3;
    --lh-text: #1c1f2a;
    --lh-teal: #00898f;
    --lh-teal-dim: rgba(0, 137, 143, 0.12);
  }
  .rh-lang {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--lh-text);
    text-decoration: none;
    border: 1px solid var(--lh-line);
    background: rgba(10, 18, 22, 0.7);
    backdrop-filter: blur(6px);
    padding: 0.45rem 0.7rem;
    border-radius: 4px;
  }
  .rh-lang:hover {
    border-color: var(--lh-teal);
  }
  .rh-theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lh-text);
    border: 1px solid var(--lh-line);
    background: rgba(10, 18, 22, 0.7);
    backdrop-filter: blur(6px);
    padding: 0.45rem;
    border-radius: 4px;
    cursor: pointer;
  }
  .rh-theme-toggle:hover {
    border-color: var(--lh-teal);
  }
  .rh-theme-toggle .material-symbols-outlined {
    font-size: 1.15rem;
  }
  .rh-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lh-text);
    background: transparent;
    border: none;
    padding: 0.45rem;
    border-radius: 4px;
    cursor: pointer;
  }
  .rh-menu-toggle:hover {
    color: var(--lh-teal);
  }
  .rh-menu-toggle .material-symbols-outlined {
    font-size: 1.15rem;
  }
  .rh-menu-toggle .menu-icon-close,
  .rh-menu.rh-menu-open .rh-menu-toggle .menu-icon-open {
    display: none;
  }
  .rh-menu.rh-menu-open .rh-menu-toggle .menu-icon-close {
    display: inline-block;
  }

  .rh-menu-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 1002;
    display: flex;
    flex-direction: column;
    min-width: 180px;
    border: 1px solid var(--lh-line);
    background: rgba(10, 18, 22, 0.92);
    backdrop-filter: blur(6px);
    border-radius: 4px;
    padding: 0.4rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  html:not(.dark) .rh-lang,
  html:not(.dark) .rh-theme-toggle {
    background: rgba(255, 255, 255, 0.72);
  }
  html:not(.dark) .rh-menu-panel {
    background: rgba(255, 255, 255, 0.92);
  }
  .rh-menu.rh-menu-open .rh-menu-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  .rh-menu-panel a {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--lh-text);
    text-decoration: none;
    padding: 0.5rem 0.6rem;
    border-radius: 3px;
    white-space: nowrap;
  }
  .rh-menu-panel a:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--lh-teal);
  }
  /* Highlights the link for the section currently in view (scroll-spy driven,
     see script below) or, server-rendered, the blog routes. */
  .rh-menu-panel a.is-active {
    color: var(--lh-teal);
    background: var(--lh-teal-dim);
  }
  /* Desktop: nav reads as a plain always-visible bar, like any landing page —
     no hamburger, no dropdown. Mobile keeps the toggle + collapsible panel. */
  @media (min-width: 901px) {
    .rh-menu-toggle {
      display: none;
    }
    .rh-menu-panel {
      position: static;
      flex-direction: row;
      min-width: max-content;
      border: none;
      background: transparent;
      backdrop-filter: none;
      padding: 0;
      opacity: 1;
      pointer-events: auto;
      transform: none;
      gap: 4px;
    }
  }
  @media (max-width: 900px) {
    /* Mobile: hamburger reads as the rightmost/edge control, not leftmost. */
    .rh-menu {
      order: 3;
    }
  }

  .rh-lang:focus-visible,
  .rh-theme-toggle:focus-visible,
  .rh-menu-toggle:focus-visible,
  .rh-menu-panel a:focus-visible {
    outline: 2px solid var(--lh-teal);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>

<script>
  // Language switcher: keep it pointed at the section currently in view, so
  // switching locale lands you in the same place instead of scrolling to top.
  // Anchors carry the locale home path ("/#hardware"), so match on link.hash
  // and only spy links that target the current page.
  const langToggle = document.getElementById("lang-toggle");
  if (langToggle) {
    const baseHref = langToggle.getAttribute("href") ?? "";
    const samePageAnchors = [...document.querySelectorAll<HTMLAnchorElement>("a[href]")].filter(
      (a) => a.hash && a.origin === location.origin && a.pathname === location.pathname
    );
    const anchorIds = new Set(samePageAnchors.map((a) => a.hash.slice(1)));
    const menuLinks = [
      ...document.querySelectorAll<HTMLAnchorElement>("#hero-menu-panel a"),
    ].filter((a) => a.hash && a.pathname === location.pathname);
    const visible = new Map<string, number>();
    const apply = () => {
      let activeId = "";
      let best = 0;
      for (const [id, ratio] of visible) {
        if (ratio > best) {
          best = ratio;
          activeId = id;
        }
      }
      langToggle.setAttribute("href", baseHref + (activeId ? "#" + activeId : ""));
      menuLinks.forEach((link) => {
        link.classList.toggle("is-active", link.hash === "#" + activeId);
      });
    };
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.set(e.target.id, e.intersectionRatio);
          else visible.delete(e.target.id);
        }
        apply();
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    document.querySelectorAll("main [id]").forEach((el) => {
      if (anchorIds.has(el.id)) spy.observe(el);
    });
    // The footer lives outside <main>; track it too so switching locale from
    // the footer keeps you on the footer instead of jumping to a section.
    const footerEl = document.querySelector("footer[id]");
    if (footerEl) spy.observe(footerEl);
  }

  // Nav menu: click to open/close, close on outside click, Escape, or link pick.
  const heroMenu = document.getElementById("hero-menu");
  const heroMenuToggle = document.getElementById("hero-menu-toggle");
  if (heroMenu && heroMenuToggle) {
    const closeMenu = () => {
      heroMenu.classList.remove("rh-menu-open");
      heroMenuToggle.setAttribute("aria-expanded", "false");
    };
    heroMenuToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = heroMenu.classList.toggle("rh-menu-open");
      heroMenuToggle.setAttribute("aria-expanded", String(open));
    });
    heroMenu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("click", (e) => {
      if (!heroMenu.contains(e.target as Node)) closeMenu();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });
  }
</script>
