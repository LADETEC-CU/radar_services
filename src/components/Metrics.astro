---
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="metrics" class="relative border-y border-outline-variant/30 py-24">
  <div class="container mx-auto max-w-container-max px-margin-mobile">
    <div class="text-center">
      <p
        class="font-technical-label text-technical-label tracking-widest text-primary-container uppercase"
      >
        {t("metrics.eyebrow")}
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="mt-16 grid gap-gutter md:grid-cols-3">
      <div class="glass-panel rounded-lg p-8 text-center">
        <p class="font-display-lg text-headline-md font-bold text-primary-container">40+</p>
        <p class="mt-2 text-body-lg text-on-surface-variant">
          {t("metrics.years")}
        </p>
      </div>

      <div class="glass-panel rounded-lg p-8 text-center">
        <p class="font-display-lg text-headline-md font-bold text-secondary-container">100%</p>
        <p class="mt-2 text-body-lg text-on-surface-variant">
          {t("metrics.deployments")}
        </p>
      </div>

      <div class="glass-panel rounded-lg p-8 text-center">
        <p class="font-display-lg text-headline-md font-bold text-primary-container">24/7</p>
        <p class="mt-2 text-body-lg text-on-surface-variant">
          {t("metrics.custom")}
        </p>
      </div>
    </div>

    <!-- Partners / Alliances Logos -->
    <div class="mt-20">
      <p
        class="mb-8 text-center font-technical-label text-technical-label tracking-widest text-outline uppercase"
      >
        {t("metrics.partners")}
      </p>
      <div
        class="flex flex-wrap items-center justify-center gap-16 opacity-30 grayscale transition-all duration-500 hover:grayscale-0"
      >
        <span class="font-headline-md font-bold tracking-tighter text-on-background">INSMET</span>
        <span class="font-headline-md font-bold tracking-tighter text-on-background"
          >DEFENSA CIVIL</span
        >
        <span class="font-headline-md font-bold tracking-tighter text-on-background">WMO / OMM</span
        >
        <span class="font-headline-md font-bold tracking-tighter text-on-background"
          >MRL-5 NETWORK</span
        >
        <span class="font-headline-md font-bold tracking-tighter text-on-background"
          >LADETEC LABS</span
        >
      </div>
    </div>
  </div>
</section>
