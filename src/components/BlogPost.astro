---
// Single-post article body, shared by both locale [slug] routes.
import { render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveLang, useTranslations } from "../i18n/utils";
import type { BlogEntry } from "../lib/blog";

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
const blogHref = getRelativeLocaleUrl(lang, "blog");
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat(lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Calculate estimated reading time (approx. 200 words per minute)
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readTime = Math.max(1, Math.ceil(words / 200));
---

<main class="relative z-10 min-h-screen pb-20">
  <article class="container mx-auto max-w-4xl px-margin-mobile pt-24">
    <!-- Back to Blog Link -->
    <a
      href={blogHref}
      class="group inline-flex items-center gap-2 font-technical-label text-technical-label tracking-widest text-outline uppercase transition-colors hover:text-primary-container"
    >
      <span
        class="material-symbols-outlined text-sm transition-transform group-hover:-translate-x-1"
        >arrow_back</span
      >
      <span>{t("blog.back")}</span>
    </a>

    <!-- Article Header -->
    <header class="mt-8">
      <!-- Metadata Chips -->
      <div
        class="flex flex-wrap items-center gap-3 font-technical-label text-technical-label tracking-widest uppercase"
      >
        <time
          datetime={new Date(post.data.date).toISOString()}
          class="inline-flex items-center gap-1.5 rounded-md border border-outline-variant/30 bg-surface-variant/60 px-3 py-1 text-primary-container backdrop-blur-sm"
        >
          <span class="material-symbols-outlined text-xs">calendar_today</span>
          <span>{dateFmt.format(new Date(post.data.date))}</span>
        </time>

        <span
          class="inline-flex items-center gap-1.5 rounded-md border border-outline-variant/20 bg-surface-variant/40 px-3 py-1 text-on-surface-variant"
        >
          <span class="material-symbols-outlined text-xs">schedule</span>
          <span>{readTime} {t("blog.minRead")}</span>
        </span>
      </div>

      <!-- Main Title -->
      <h1
        class="mt-6 text-3xl leading-tight font-extrabold tracking-tight text-on-background sm:text-4xl md:text-5xl"
      >
        {post.data.title}
      </h1>

      <!-- Excerpt / Subtitle -->
      {
        post.data.excerpt && (
          <p class="mt-6 border-l-2 border-primary-container/80 pl-4 text-lg leading-relaxed text-on-surface-variant italic">
            {post.data.excerpt}
          </p>
        )
      }
    </header>

    <!-- Post Content Block -->
    <div class="wp-content mt-10 font-body-lg text-on-surface">
      <Content />
    </div>

    <!-- Article Footer / Navigation -->
    <footer class="mt-16 border-t border-outline-variant/30 pt-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a
          href={blogHref}
          class="glow-button inline-flex items-center gap-2 rounded-lg bg-surface-variant px-5 py-2.5 font-technical-label text-xs font-bold tracking-widest text-primary-container uppercase transition-all"
        >
          <span class="material-symbols-outlined text-sm">arrow_back</span>
          <span>{t("blog.back")}</span>
        </a>

        <button
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-outline-variant/40 bg-surface/50 px-4 py-2 font-technical-label text-xs tracking-widest text-on-surface-variant uppercase transition-colors hover:bg-surface-variant hover:text-on-background"
        >
          <span>{t("blog.backToTop")}</span>
          <span class="material-symbols-outlined text-sm">arrow_upward</span>
        </button>
      </div>
    </footer>
  </article>
</main>

<style>
  /* Base content block HTML arrived from rendered Markdown / WP HTML export.
     Targeting using :global() for theme integration. */

  /* Overrides for WP inline typography & clamps */
  .wp-content :global(p),
  .wp-content :global(.wp-block-paragraph) {
    margin-block: 1.5rem;
    font-size: 1.125rem !important;
    line-height: 1.8 !important;
    color: var(--color-on-surface);
  }

  /* Reset legacy WP inline color classes and mark tags */
  .wp-content :global(.has-inline-color),
  .wp-content :global(.has-blue-color),
  .wp-content :global(mark) {
    color: inherit !important;
    background-color: transparent !important;
  }

  /* Headings */
  .wp-content :global(h1),
  .wp-content :global(h2),
  .wp-content :global(h3),
  .wp-content :global(h4),
  .wp-content :global(h5),
  .wp-content :global(h6),
  .wp-content :global(.wp-block-heading) {
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-on-background);
    scroll-margin-top: 5rem;
  }

  .wp-content :global(h1) {
    margin-block: 2.5rem 1.25rem;
    font-size: 2.25rem;
  }

  .wp-content :global(h2),
  .wp-content :global(.wp-block-heading) {
    margin-block: 2.5rem 1.25rem;
    font-size: 1.75rem;
    border-left: 3px solid var(--color-primary-container);
    padding-left: 0.75rem;
  }

  .wp-content :global(h3) {
    margin-block: 2rem 1rem;
    font-size: 1.375rem;
  }

  .wp-content :global(h4) {
    margin-block: 1.75rem 0.875rem;
    font-size: 1.125rem;
  }

  /* Links */
  .wp-content :global(a) {
    color: var(--color-primary-container);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }
  .wp-content :global(a:hover) {
    opacity: 0.8;
  }

  /* Images & Figures */
  .wp-content :global(figure),
  .wp-content :global(.wp-block-image) {
    margin-block: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wp-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 0.75rem);
    border: 1px solid var(--color-outline-variant);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.12);
  }

  .wp-content :global(figcaption),
  .wp-content :global(.wp-element-caption) {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    text-align: center;
    font-style: italic;
  }

  /* Blockquotes */
  .wp-content :global(blockquote),
  .wp-content :global(.wp-block-quote) {
    margin-block: 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--color-primary-container);
    background-color: var(--color-surface-variant);
    border-radius: 0 0.5rem 0.5rem 0;
    color: var(--color-on-surface);
    font-style: italic;
  }

  .wp-content :global(blockquote p) {
    margin-block: 0.5rem !important;
  }

  /* Code & Pre */
  .wp-content :global(code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.875em;
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    background-color: var(--color-surface-variant);
    color: var(--color-primary-container);
    border: 1px solid var(--color-outline-variant);
  }

  .wp-content :global(pre),
  .wp-content :global(.wp-block-code) {
    margin-block: 2rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    background-color: var(--color-surface-variant);
    border: 1px solid var(--color-outline-variant);
    overflow-x: auto;
  }

  .wp-content :global(pre code) {
    padding: 0;
    background-color: transparent;
    border: none;
    color: var(--color-on-surface);
  }

  /* Lists */
  .wp-content :global(ul),
  .wp-content :global(ol),
  .wp-content :global(.wp-block-list) {
    margin-block: 1.5rem;
    padding-inline-start: 1.75rem;
  }

  .wp-content :global(ul) {
    list-style-type: disc;
  }

  .wp-content :global(ol) {
    list-style-type: decimal;
  }

  .wp-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  /* Tables */
  .wp-content :global(table),
  .wp-content :global(.wp-block-table) {
    margin-block: 2.5rem;
    width: 100%;
    border-collapse: collapse;
    overflow-x: auto;
    display: block;
  }

  .wp-content :global(th) {
    background-color: var(--color-surface-variant);
    color: var(--color-on-background);
    padding: 0.875rem 1rem;
    font-weight: 600;
    text-align: left;
    border-bottom: 2px solid var(--color-outline-variant);
  }

  .wp-content :global(td) {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-outline-variant);
    color: var(--color-on-surface);
  }

  .wp-content :global(tr:nth-child(even)) {
    background-color: rgba(255, 255, 255, 0.02);
  }

  /* Horizontal dividers */
  .wp-content :global(hr),
  .wp-content :global(.wp-block-separator) {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-outline-variant), transparent);
    margin-block: 3rem;
  }

  /* Embedded media */
  .wp-content :global(iframe),
  .wp-content :global(.wp-block-embed),
  .wp-content :global(.wp-block-embed__wrapper) {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    border: none;
    margin-block: 2rem;
  }
</style>
