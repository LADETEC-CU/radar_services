---
// BlogPreview.astro
// Displays the latest 3 blog articles on the landing page.
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveLang, useTranslations } from "../i18n/utils";
import { getPosts, postImage } from "../lib/blog";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const allPosts = await getPosts(lang);
const posts = allPosts.slice(0, 3);

const blogHref = getRelativeLocaleUrl(lang, "blog");
const dateFmt = new Intl.DateTimeFormat(lang, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

{
  posts.length > 0 && (
    <section id="blog-preview" class="relative py-32 transition-colors duration-300">
      <div class="container mx-auto max-w-container-max px-margin-mobile">
        <div class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
          <div>
            <div class="mb-2 inline-block border-b border-primary-container/20 pb-1">
              <h2 class="font-technical-label text-sm font-bold tracking-widest text-primary-container uppercase">
                {t("blog.preview.eyebrow")}
              </h2>
            </div>
            <h3 class="text-headline-md text-on-background">{t("blog.preview.heading")}</h3>
          </div>
          <a
            href={blogHref}
            class="group flex items-center gap-2 font-technical-label text-xs font-bold tracking-widest text-primary-container uppercase transition-all hover:gap-3"
          >
            <span>{t("blog.preview.viewAll")}</span>
            <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">
              arrow_forward
            </span>
          </a>
        </div>

        <div class="grid gap-gutter md:grid-cols-3">
          {posts.map((post) => {
            const image = postImage(post);
            const postHref = getRelativeLocaleUrl(lang, `blog/${post.data.slug}`);
            const words = post.body ? post.body.trim().split(/\s+/).length : 0;
            const readTime = Math.max(1, Math.ceil(words / 200));

            return (
              <article class="glass-panel group relative flex flex-col overflow-hidden rounded-xl border border-outline-variant/30 transition-all duration-300 hover:-translate-y-1 hover:border-primary-container/50 hover:shadow-xl hover:shadow-primary-container/5">
                {image ? (
                  <a
                    href={postHref}
                    tabindex="-1"
                    aria-hidden="true"
                    class="relative block h-48 overflow-hidden bg-surface-variant/40"
                  >
                    <img
                      src={image.src}
                      alt={image.alt || post.data.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent opacity-60 transition-opacity group-hover:opacity-40" />
                  </a>
                ) : (
                  <a
                    href={postHref}
                    tabindex="-1"
                    aria-hidden="true"
                    class="relative flex h-36 items-center justify-center overflow-hidden border-b border-outline-variant/20 bg-surface-variant/30 p-6"
                  >
                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-primary-container)_0%,transparent_70%)] opacity-10" />
                    <span class="material-symbols-outlined text-4xl text-primary-container/40 transition-transform duration-300 group-hover:scale-110 group-hover:text-primary-container/60">
                      radar
                    </span>
                  </a>
                )}

                <div class="flex grow flex-col p-6">
                  <div class="flex items-center justify-between gap-2 font-technical-label text-[11px] tracking-widest text-outline uppercase">
                    <time datetime={new Date(post.data.date).toISOString()}>
                      {dateFmt.format(new Date(post.data.date))}
                    </time>
                    <span class="inline-flex items-center gap-1 text-primary-container/80">
                      <span class="material-symbols-outlined text-xs">schedule</span>
                      {readTime} {t("blog.minRead")}
                    </span>
                  </div>

                  <h4 class="mt-3 text-lg leading-snug font-bold text-on-background transition-colors group-hover:text-primary-container">
                    <a href={postHref}>{post.data.title}</a>
                  </h4>

                  {post.data.excerpt && (
                    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-on-surface-variant">
                      {post.data.excerpt}
                    </p>
                  )}

                  <div class="mt-auto pt-6">
                    <a
                      href={postHref}
                      class="inline-flex items-center gap-1.5 font-technical-label text-xs font-bold tracking-widest text-primary-container uppercase transition-all group-hover:gap-2.5"
                    >
                      <span>{t("blog.readMore")}</span>
                      <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">
                        arrow_forward
                      </span>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}
