---
// BlogPreview.astro
// Displays the latest 3 blog articles on the landing page.
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveLang, useTranslations } from "../i18n/utils";
import { getPosts, postImage } from "../lib/blog";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const allPosts = await getPosts(lang);
const posts = allPosts.slice(0, 3);

const blogHref = getRelativeLocaleUrl(lang, "blog");
const dateFmt = new Intl.DateTimeFormat(lang, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

{
  posts.length > 0 && (
    <section id="blog-preview" class="relative py-32 transition-colors duration-300">
      <div class="container mx-auto max-w-container-max px-margin-mobile">
        <div class="mb-16 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
          <div>
            <div class="mb-2 inline-block border-b border-primary-container/20 pb-1">
              <h2 class="font-technical-label text-sm font-bold tracking-widest text-primary-container uppercase">
                {t("blog.preview.eyebrow")}
              </h2>
            </div>
            <h3 class="text-headline-md text-on-background">{t("blog.preview.heading")}</h3>
          </div>
          <a
            href={blogHref}
            class="group flex items-center gap-2 font-technical-label text-xs font-bold tracking-widest text-primary-container uppercase transition-all hover:gap-3"
          >
            <span>{t("blog.preview.viewAll")}</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>

        <div class="grid gap-gutter md:grid-cols-3">
          {posts.map((post) => {
            const image = postImage(post);
            const postHref = getRelativeLocaleUrl(lang, `blog/${post.data.slug}`);
            return (
              <article class="glass-panel group relative flex flex-col overflow-hidden rounded-xl transition-all duration-300 hover:border-primary-container/40">
                {image && (
                  <a href={postHref} tabindex="-1" aria-hidden="true" class="overflow-hidden">
                    <img
                      src={image.src}
                      alt={image.alt || post.data.title}
                      loading="lazy"
                      class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </a>
                )}
                <div class="flex grow flex-col p-6">
                  <time
                    datetime={new Date(post.data.date).toISOString()}
                    class="font-technical-label text-[10px] tracking-widest text-outline uppercase"
                  >
                    {dateFmt.format(new Date(post.data.date))}
                  </time>
                  <h4 class="mt-2 font-headline-md text-base font-bold text-on-background transition-colors group-hover:text-primary-container">
                    <a href={postHref}>{post.data.title}</a>
                  </h4>
                  {post.data.excerpt && (
                    <div class="blog-excerpt mt-3 grow text-body-sm text-on-surface-variant">
                      {post.data.excerpt}
                    </div>
                  )}
                  <a
                    href={postHref}
                    class="mt-6 flex items-center gap-1 font-technical-label text-xs font-bold tracking-widest text-primary-container uppercase transition-all group-hover:gap-2"
                  >
                    <span>{t("blog.readMore")}</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  .blog-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
</style>
