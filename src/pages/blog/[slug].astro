---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import BlogPost from "../../components/BlogPost.astro";
import { getPosts, decodeEntities, type WpPost } from "../../lib/wp";

export async function getStaticPaths() {
  // 100 is the WP REST per_page cap; add pagination here if the category outgrows it.
  const posts = await getPosts("en", 100);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: WpPost;
}

const { post } = Astro.props;
---

<Layout title={`${decodeEntities(post.title.rendered)} | LADETEC`}>
  <BlogPost post={post} />
  <Footer />
</Layout>
