---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { resolveLang, useTranslations } from "../../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
const homeHref = getRelativeLocaleUrl(lang, "");
---

<Layout title={t("blog.title")}>
  <main class="relative z-10 flex min-h-screen items-center">
    <div class="container mx-auto max-w-container-max px-margin-mobile py-32 text-center">
      <h1
        class="font-display-lg text-display-lg-mobile leading-tight text-on-background md:text-headline-md"
      >
        {t("blog.title")}
      </h1>
      <p class="mt-4 font-body-lg text-on-surface-variant">{t("blog.body")}</p>
      <a
        href={homeHref}
        class="mt-8 inline-block font-technical-label text-technical-label text-outline uppercase transition-colors hover:text-primary-container"
      >
        {t("nav.home")}
      </a>
    </div>
  </main>
  <Footer />
</Layout>
